# Browser-safe values (Vite exposes VITE_* to the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_CLAUDE_PROXY=true
# Set to your Telegram bot username (no @) to switch on Settings > Personal assistant. Leave empty to hide it.
VITE_TELEGRAM_BOT_USERNAME=
# NEVER put server secrets (Anthropic key, Telegram token, service role key) in VITE_ variables.
# They belong in Supabase Edge Function secrets — see docs/ASSISTANT_SETUP.md
